# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dedup_user
POSTGRES_PASSWORD=dedup_password
POSTGRES_DB=dedup_db

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=reclamation_processing
KAFKA_DLQ_TOPIC=dead_letter_topic
KAFKA_CONSUMER_GROUP=dedup_workers

# ML Configuration
LABSE_MODEL=sentence-transformers/LaBSE
EMBEDDING_DIMENSION=768

# Duplicate Detection Thresholds
THRESHOLD_AUTO_DUPLICATE=0.95
THRESHOLD_REVIEW=0.85
TIME_WINDOW_DAYS=7
